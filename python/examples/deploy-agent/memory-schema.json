{
  "$schema": "https://loomwork.dev/schemas/memory/v0.1.json",
  "stores": {
    "episodic": {
      "type": "timeline",
      "retention": "365d",
      "fields": ["deploy_id", "artifact_uri", "env", "outcome", "rolled_back", "duration_ms"]
    },
    "semantic": {
      "type": "graph",
      "fields": ["service", "version", "deployed_at", "deploy_id"]
    },
    "procedural": {
      "type": "vector",
      "embeddingModel": "bge-small-en-v1.5",
      "dimensions": 384,
      "fields": ["failure_pattern", "mitigation", "service"]
    }
  },
  "encryption": { "algorithm": "AES-256-GCM", "keyDerivation": "PBKDF2-SHA256-200k" },
  "provenance": { "required": true, "signatureAlgorithm": "Ed25519" }
}
